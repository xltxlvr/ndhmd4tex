# ndhmdsync.ini — ndhmdsync.py 의 에디터/뷰어 명령 설정 파일
#
# ── 이 파일을 어디에 둘 것인가 ──────────────────────────────────────
# 다음 세 폴더를 순서대로 뒤져서 처음 발견되는 것 하나를 쓴다(ndhmd4tex.py
# 가 공유 리소스를 찾는 resource_dirs() 와 정확히 같은 관례 — 그 옆에
# 있을 ndhmd4tex/resources 폴더와 나란히 두면 된다). OS별로 하나만
# 보는 게 아니라 셋 다 훑으므로, 여러 기계에서 설정을 동기화해 쓰는
# 경우(Dropbox, iCloud 등으로 홈 폴더 일부를 맞춰 쓰는 경우)에도 그대로
# 통한다.
#
#   ~/Library/ndhmd4tex/config/ndhmdsync.ini
#   ~/ndhmd4tex/config/ndhmdsync.ini
#   ~/.config/ndhmd4tex/config/ndhmdsync.ini
#
# 이 파일 자체는 예시이자 템플릿이다 — 배포된 그대로는 파일 이름이
# "ndhmdsync.ini.example"이라 아무 효과가 없다. 실제로 쓰려면 위 세 곳
# 중 하나에 "ndhmdsync.ini" 라는 이름으로 복사하고, 아래에서 필요한
# 줄의 맨 앞 "#"를 지워 켠 다음, 자신의 환경에 맞게 명령을 고칠 것.
#
# ── 이 파일이 없으면 어떻게 되는가 ──────────────────────────────────
# ndhmdsync.py 는 이 설정이 없어도 잘 동작한다 — 하드코딩된 기본값을
# 그대로 쓴다: 에디터는 VS Code(`code --goto`), PDF 뷰어는 실행 중인
# OS에 맞춰 Windows는 SumatraPDF, macOS는 Skim, 그 외(Linux)는 Okular.
# 이 파일은 그 기본값을 다른 에디터·뷰어로, 또는 SumatraPDF/Skim/Okular
# 를 표준 설치 위치가 아닌 다른 곳에 둔 경우를 위해 존재한다.
#
# ── 자리표시자 ────────────────────────────────────────────────────
#   %f   대상 파일 경로 (역방향: 원본 .md, 정방향: 대상 .tex)
#   %l   줄 번호(1-based)
#   %p   PDF 파일 경로 (정방향의 PDFVIEW 에서만 쓸 수 있다 — 역방향의
#        EDITOR 는 PDF 를 열 일이 없으므로 %p 가 없다)
#
# ── 공백이 있는 경로 ────────────────────────────────────────────────
# 실행 파일 경로에 공백이 있으면(Windows 의 "Program Files", macOS 의
# 앱 이름 등) 반드시 큰따옴표로 감쌀 것. 백슬래시는 이스케이프 문자로
# 취급되지 않고 항상 그대로 보존되므로, Windows 경로를 있는 그대로
# 옮겨 적어도 안전하다 — 예를 들어 아래처럼 쓰면 된다.
#
#   command = "C:\Program Files\SumatraPDF\SumatraPDF.exe" -reuse-instance -forward-search %f %l %p


[EDITOR]
# 역방향(--line)에서 쓸 에디터 명령. %p 는 여기서 못 쓴다(PDF와 무관).

# VS Code(기본값과 동일 — 굳이 이 파일에 켤 필요는 없지만 예시로 남긴다)
# command = code --goto %f:%l:1

# Sublime Text
# command = subl %f:%l

# Vim(GUI 터미널을 새로 띄우는 방식, 환경에 따라 조정 필요)
# command = gnome-terminal -- vim +%l %f

# 아무 셸 스크립트나 배치 파일로 감싸 쓰고 싶다면
# command = "C:\Users\me\bin\open-in-editor.bat" %f %l


[PDFVIEW]
# 정방향(--md-line)에서 쓸 PDF 뷰어 명령. %f 는 여기서 tex 파일을 뜻한다.

# SumatraPDF(기본 세 위치 중 하나에 없고 다른 곳에 설치한 경우에만 필요)
# command = "C:\Users\me\Apps\SumatraPDF\SumatraPDF.exe" -reuse-instance -forward-search %f %l %p

# Skim(기본값과 동일 — /Applications 가 아닌 다른 곳에 설치했다면 필요)
# command = "/Users/me/Applications/Skim.app/Contents/SharedSupport/displayline" %l %p %f

# Okular(기본값과 동일 — PATH에 없는 곳에 설치했다면 필요)
# command = /opt/okular/bin/okular --unique "%p#src:%l %f"

# evince(GNOME, SyncTeX 지원)
# command = evince --page-index=1 %p


[TEXEDIT]
# .nmdsync 를 찾지 못했지만 .synctex.gz/.synctex 는 있을 때(즉 이
# 문서가 애초에 ndhmd4tex.py 로 만든 게 아니라 손으로 쓴 LaTeX을 곧장
# 컴파일한 것으로 보일 때)만 쓰는, [EDITOR]의 대체 경로다. markdown
# 역추적은 할 수 없으니 .tex 자기 자신을 그 줄에서 연다. %p 는 여기서도
# 못 쓴다(PDF와 무관).
#
# 이 섹션 자체가 없거나 command 가 없으면, OS가 .tex 확장자에 연결해 둔
# 기본 프로그램으로 그냥 연다(줄 이동은 안 되지만 최소한 파일은 열린다
# — Windows라면 보통 메모장).
#
# %f 는 반드시 .tex 확장자가 붙은 채로 채워져야 정확히 동작한다(실측:
# VS Code의 `--goto 파일:줄:칸`이 특히 이 문제에 취약하다 — 확장자가
# 없으면 실제 파일과 다른 경로로 인식돼 조용히 실패하거나 엉뚱한 새
# 파일을 만들려 든다). ndhmdsync.py는 넘겨받은 파일 이름에 확장자가
# 아예 없으면 자동으로 .tex 를 보정해 붙이므로(0.5.6부터), 보통은
# 신경 쓸 필요 없다 — 다만 PDF 뷰어 쪽 설정에서 %f 를 직접 조합해
# 넘기는 식으로 바꿔 쓴다면 이 점을 유의할 것.

# TeXworks(줄 이동 지원)
# command = texworks -p=%l "%f"

# VS Code(줄 이동 지원 — [EDITOR]와 같은 프로그램을 써도 상관없다)
# command = code --goto %f:%l:1

# Vim(GUI 터미널을 새로 띄우는 방식, 환경에 따라 조정 필요)
# command = gnome-terminal -- vim +%l %f
